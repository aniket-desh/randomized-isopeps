# local research notes (repo-wide, kept out of the published history)
/briefing.md
/log.md

# curated summaries + notes (reports/*.md, make_advisor_figures.py): kept local.
# Figures ARE published so collaborators see the plots: ignore everything under
# reports/ EXCEPT the figures/ subtree (the parent dir stays un-ignored so git can
# descend into the re-included subdir).
/reports/*
!/reports/figures/
!/reports/real_moses_summary.md
!/reports/rmps_column_qr_summary.md
!/reports/rmps_disentangler_summary.md

# reference papers (kept locally, not published)
/docs/

# scratch experiment outputs: raw CSV data and every timestamped figure.
# Curated, relevant plots are committed under each suite's figures/ dir instead,
# so collaborators see the results without versioning data or every run.
**/outputs/

# raw data pulled back from NERSC by nersc/pull_data.sh (never versioned)
/nersc-data/

# python
__pycache__/
*.py[cod]

# compiled extensions / build artifacts (rebuild via build_incrementalqr.sh)
*.so
*.dylib
rand_isopeps/randommpomps/build/

# matplotlib scratch config written next to experiment outputs
.mplconfig/

# macOS
.DS_Store
